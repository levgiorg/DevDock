{
  "name": "devdock",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "test:resources": "node --experimental-strip-types scripts/check-server-resources.mjs",
    "prebuild": "node scripts/check-download.mjs",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build --webpack",
    "start": "next start",
    "test": "node --experimental-strip-types --test scripts/security.test.mjs && npm run test:resources",
    "typecheck": "tsc --noEmit",
    "security": "python3 scripts/security-scan.py && npm audit --audit-level=low",
    "verify": "npm test && npm run security && npm run build",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "marked": "18.2.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
